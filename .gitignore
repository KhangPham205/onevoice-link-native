# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Log/OS Files
*.log

# Android Studio generated files and folders
captures/
.externalNativeBuild/
.cxx/
*.aab
*.apk
output-metadata.json

# IntelliJ
*.iml
.idea/
misc.xml
deploymentTargetDropDown.xml
render.experimental.xml

# Keystore files
*.jks
*.keystore

# Google Services (e.g. APIs or Firebase)
google-services.json

# Android Profiling
*.hprof

# Vendored Qualcomm QNN SDK — large, often NDA prebuilt libs (.so + headers).
# Vendored locally under native-core/third_party/qnn_sdk; CMake falls back to
# stub mode (via __has_include) when absent, so it must NOT be committed.
# Note: google/oboe IS committed (git subtree) and is intentionally tracked.
/native-core/third_party/qnn_sdk/

# QNN context binaries (.bin) compiled AOT for Hexagon HTP v73 — ~5.9 GB.
# Delivered out-of-band by the model team; see onevoice-npu-bins/HANDOFF.md.
# The deploy layout under models-npu/ is generated from these by
# tools/models/stage-npu-models.sh, so it is regenerable and also ignored.
/onevoice-npu-bins/
/models-npu/
# Locally generated QNN stages (for example the Kokoro prosody context). The
# scripts and manifest contract are tracked; licensed/generated binaries are not.
/models-npu-generated/

# HuggingFace source + converted models for the CPU reference pipeline (multi-GB).
/models-src/
/models-hf/
# VieNeu-TTS v3 Nano weights + sea-g2p dictionary (~350 MB), from
# tools/models/prepare-vieneu-nano.py and build-sea-g2p-android.sh.
/models-vieneu/
# Generated, distributable archives made by tools/models/package-main-models.sh.
/dist/model-packs/
# Python conversion tooling
/tools/models/__pycache__/
/tools/eval/__pycache__/
/tools/eval/longturn/__pycache__/
/tools/models/.venv/
/tools/models/.pip-cache/
# Prebuilt native libs dropped in for NDK-less UI preview builds.
/android-app/app/src/main/jniLibs/arm64-v8a/*.so

# Third-party/licensed runtime binaries are fetched or copied from local SDKs.
# Keep their integration code and manifests in Git, not the binary payloads.
/android-app/app/libs/*.aar
/android-app/app/src/main/assets/dsp/*.so

# Local speech translation dataset
/Vie-Eng dataset/
# Dataset evaluation output quotes that dataset and holds ~70 MB of TTS audio;
# it ships as the submission's evidence folder, summarised in docs/.
/eval-results/
