<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Microphone capture for the utterance-based S2ST pipeline. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <uses-feature
        android:name="android.hardware.microphone"
        android:required="true" />

    <!-- Connected headset identity and public LE Audio capability probes. A
         normal BLE advertiser is not an Auracast transport, so this app does
         not request SCAN or ADVERTISE. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_CONNECT"
        tools:targetApi="s" />

    <!-- Legacy Bluetooth for pre-Android 12 devices (install-time only). -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- pageSizeCompat: the x86_64 EMULATOR libs (sherpa-onnx/ONNX Runtime
         prebuilts) are not 16 KB ELF-aligned upstream; this opts that ABI into
         Android 16's page-size compatibility mode without the warning dialog.
         The arm64-v8a device libs (incl. our core) ARE 16 KB aligned. -->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:pageSizeCompat="enabled"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.OneVoiceLink">
        <!--
            QNN's V73 FastRPC stub has DT_NEEDED libcdsprpc.so. Since this app
            targets API 31+, Android does not expose vendor non-NDK libraries
            to its linker namespace unless they are requested explicitly.
            Samsung lists libcdsprpc.so as a public vendor library on SM8550.
        -->
        <uses-native-library
            android:name="libcdsprpc.so"
            android:required="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.OneVoiceLink"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Benchmark control surface, driven by `adb shell am broadcast`.

            It has to be exported: on this Android build a shell broadcast to a
            non-exported receiver is dropped before it is even enqueued, even
            when -n names the component (verified on the target — the
            ActivityManager "Broadcasting" line never appears).

            A signature-level android:permission was tried first and silently
            swallowed the broadcast on this build, so the guard is instead:
            every action is inert unless <filesDir>/bench exists, and that
            directory can only be created through run-as, which requires a
            debuggable build. A release build therefore carries the class but
            can never be made to act on it.
        -->
        <receiver
            android:name=".core.BenchControlReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.onevoice.link.BENCH" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
